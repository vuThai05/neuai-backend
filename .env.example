# MongoDB Connection URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=YourAppName
# Hoặc: mongodb://localhost:27017/database (cho local MongoDB)
MONGO_URI= your_mongodb_connection_uri_here

# Qdrant Connection String
QDRANT_URL= your_qdrant_connection_string_here
QDRANT_KEY= your_qdrant_api_key_here

# Ollama Configuration
# Base URL should point to your Ollama host root (without /api/generate).
OLLAMA_BASE_URL= your_ollama_base_url_here
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60

# Frontend URL for CORS (Next.js dev server)
FRONTEND_URL=http://localhost:3000